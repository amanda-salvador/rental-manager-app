# .env.example — Copy this file to .env and fill in your real values.
# .env is gitignored and never committed.

# Path to your downloaded Google Service Account JSON key
GOOGLE_CREDENTIALS_PATH=credentials.json

# Google Spreadsheet ID (from the URL: docs.google.com/spreadsheets/d/SPREADSHEET_ID/edit)
SPREADSHEET_ID=your_spreadsheet_id_here

# Google Drive folder IDs (from the URL: drive.google.com/drive/folders/FOLDER_ID)
DRIVE_FOLDER_RECEIPTS=your_receipts_folder_id_here
DRIVE_FOLDER_MAINTENANCE=your_maintenance_folder_id_here
DRIVE_FOLDER_DOCUMENTS=your_documents_folder_id_here
# Parent folder for property photos — app auto-creates per-property subfolders inside it
DRIVE_FOLDER_PHOTOS=your_photos_folder_id_here

# Optional: set a password to protect the app (leave blank for open access)
APP_PASSWORD=

# --- Your portfolio --------------------------------------------------------
# Property display names (comma-separated). These appear in every dropdown.
PROPERTIES=Property One,Property Two,Property Three,Property Four
# Street addresses as a JSON object — keys MUST match the names in PROPERTIES.
# Used on the move-in packet and other renter-facing PDFs.
PROPERTY_ADDRESSES={"Property One": "123 Example St", "Property Two": "456 Sample Ave", "Property Three": "789 Demo Blvd", "Property Four": "101 Placeholder Ln"}
# Vehicles for the mileage tracker (comma-separated).
VEHICLES=Vehicle One,Vehicle Two
# Property pre-selected when these forms open. Must match a name in PROPERTIES;
# leave blank to default to the first property.
DEFAULT_EXPENSE_PROPERTY=
DEFAULT_MILEAGE_PROPERTY=

# Landlord/manager contact shown on the move-in packet PDF footer.
LANDLORD_NAME=Property Manager
LANDLORD_PHONE=(555) 555-5555
LANDLORD_EMAIL=manager@example.com
